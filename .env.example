# PLACEHOLDERS ONLY. Copy to .env.local. Never commit .env.local, secrets or real tokens.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/shiplock.sqlite
SESSION_SECRET=CHANGE_ME_RANDOM_32_PLUS_BYTES
API_PORT=4000
# Web server -> API origin (server-side only; the browser uses the same-origin /api proxy)
SHIPLOCK_API_ORIGIN=http://127.0.0.1:4000
# Bearer token the coding agent uses for POST /api/reviews (>= 32 chars). Unset = endpoint disabled.
SHIPLOCK_AGENT_TOKEN=

# Hedera testnet, exact cryptoTransfer HBAR x402
HEDERA_NETWORK=hedera:testnet
# The API accepts paid reviews only from this payer account.
HEDERA_AGENT_ACCOUNT_ID=0.0.REPLACE_ME
HEDERA_AGENT_PRIVATE_KEY=REPLACE_ME_LOCAL_SECRET
HEDERA_AUDIT_PAYTO_ACCOUNT_ID=0.0.REPLACE_ME
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
AUDIT_PRICE_TINYBAR=1000
AGENT_MAX_PAYMENT_TINYBAR=10000
# x402 asset id for native HBAR as quoted by the merchant (confirm against Hermes's payment contract)
X402_HBAR_ASSET=0.0.0
# Paid-review evidence ShipLock accepts: "live" for the demo. Adding "simulated" is for local UI work only;
# simulated reviews can be approved for display but never merged.
SHIPLOCK_ACCEPTED_EVIDENCE=live
# Optional HCS only after core demo works
HEDERA_HCS_OPERATOR_ACCOUNT_ID=
HEDERA_HCS_OPERATOR_PRIVATE_KEY=
HEDERA_HCS_TOPIC_ID=

# World ID (IDKit 4.0) — values from the World Developer Portal. Unset = World endpoints return 503.
# app_id and rp_id are public; the RP signing key is a server-only secret (never NEXT_PUBLIC_*, never logged).
WORLD_APP_ID=app_REPLACE_ME
WORLD_RP_ID=rp_REPLACE_ME
WORLD_RP_SIGNING_KEY=REPLACE_ME_SERVER_ONLY
# staging = World ID Simulator (development proofs, NOT real human verification); production = real World App
WORLD_ENVIRONMENT=staging
# Enrollment action; must exist in the Portal in the same environment as WORLD_ENVIRONMENT
WORLD_ENROLL_ACTION=shiplock-maintainer-enroll
# Fresh user-presence check on every proof. May only be false with WORLD_ENVIRONMENT=staging.
WORLD_REQUIRE_USER_PRESENCE=true
WORLD_VERIFY_BASE_URL=https://developer.world.org

# GitHub OAuth App (maintainer sign-in, identity only). Callback: ${APP_URL}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=REPLACE_ME
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_ME_SERVER_ONLY
# Minimum repository role to approve/merge: write | maintain | admin
SHIPLOCK_MIN_GITHUB_PERMISSION=write
SHIPLOCK_MERGE_METHOD=squash
# true lets staging World proofs or non-live paid evidence merge (development evidence; demo repo only).
SHIPLOCK_ALLOW_DEVELOPMENT_MERGE=false

# GitHub disposable demo target only (never production repos). Comma-separated allowlist.
GITHUB_DEMO_REPO=Hebx/shiplock-demo-target
# Fine-grained token for the demo repo only: Contents RW, Pull requests RW, Checks R, Commit statuses R, Metadata R
GITHUB_FINE_GRAINED_TOKEN=REPLACE_ME_DEMO_REPO_ONLY
# Future least-privilege GitHub App alternative
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Optional, informational LLM summary only
LLM_API_KEY=
