# PLACEHOLDERS ONLY. Copy to .env.local. Never commit .env.local, secrets or real tokens.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/shiplock.sqlite
SESSION_SECRET=CHANGE_ME_RANDOM_32_PLUS_BYTES

# Hedera testnet, exact cryptoTransfer HBAR x402
HEDERA_NETWORK=hedera:testnet
HEDERA_AGENT_ACCOUNT_ID=0.0.REPLACE_ME
HEDERA_AGENT_PRIVATE_KEY=REPLACE_ME_LOCAL_SECRET
HEDERA_AUDIT_PAYTO_ACCOUNT_ID=0.0.REPLACE_ME
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
AUDIT_PRICE_TINYBAR=1000
AGENT_MAX_PAYMENT_TINYBAR=10000
# Optional HCS only after core demo works
HEDERA_HCS_OPERATOR_ACCOUNT_ID=
HEDERA_HCS_OPERATOR_PRIVATE_KEY=
HEDERA_HCS_TOPIC_ID=

# World Agent Pass official OIDC
WORLD_OIDC_ISSUER=https://auth.world.org
WORLD_OIDC_CLIENT_ID=REPLACE_ME
WORLD_OIDC_CLIENT_SECRET=REPLACE_IF_REQUIRED
WORLD_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/world/callback
WORLD_REQUIRE_ACR=  # Confirm accepted assurance values against the current World event IdP docs

# GitHub disposable demo target only (never production repos)
GITHUB_DEMO_REPO=Hebx/shiplock-demo-target
GITHUB_FINE_GRAINED_TOKEN=REPLACE_ME_DEMO_REPO_ONLY
# Future least-privilege GitHub App alternative
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Optional, informational LLM summary only
LLM_API_KEY=
